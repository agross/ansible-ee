{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":disableDigestUpdates",
    ":disableRateLimiting",
    ":enableVulnerabilityAlerts",
    ":rebaseStalePrs",
    ":semanticCommitsDisabled"
  ],
  "labels": [
    "dependencies"
  ],
  "customDatasources": {
    "fedora-stable": {
      "defaultRegistryUrlTemplate": "https://endoflife.date/api/fedora.json",
      "transformTemplates": [
        "{\"releases\": $[releaseDate <= $substring($now(), 0, 10)].{\"version\": cycle, \"releaseTimestamp\": releaseDate}}"
      ]
    }
  },
  "packageRules": [
    {
      "description": "Only suggest released Fedora versions, not Rawhide",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["registry.fedoraproject.org/fedora-minimal"],
      "overrideDatasource": "custom.fedora-stable",
      "overridePackageName": "fedora"
    }
  ],
  "customManagers": [
    {
      "description": "Magic comments",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/).+\\.(ya?ml|j2)$/",
        "/(^|/)Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: (?<datasource>[a-z-.]+?)=(?<packageName>.+?)(?: depName=(?<depName>.+?))?(?: versioning=(?<versioning>[a-z-]+?))?\\s.+?\\w+?[:=]\\s*(?<currentValue>.+?)\\s",
        "# renovate: (?<datasource>pypi)(?: depName=(?<depName>.+?))?(?: versioning=(?<versioning>[a-z-]+?))?\\s.+?(?<packageName>\\w+?)==\\s*(?<currentValue>.+?)\\s",
        "# renovate: (?<datasource>git-refs)=(?<packageName>.+?) ref=(?<currentValue>.+?)(?: depName=(?<depName>.+?))?(?: versioning=(?<versioning>[a-z-]+?))?\\s.+?\\w+?[:=]\\s*(?<currentDigest>.+?)\\s"
      ]
    }
  ]
}
